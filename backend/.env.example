# Claude Scientific Copilot (server-side only; never put this key in the frontend)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# Neo4j AuraDB (optional; without it the app uses the in-memory graph + SQLite and says so)
NEO4J_URI=neo4j+s://ff289c12.databases.neo4j.io
NEO4J_USERNAME=ff289c12
NEO4J_PASSWORD=
NEO4J_DATABASE=ff289c12
AURA_INSTANCEID=ff289c12
AURA_INSTANCENAME=SpaceXtinsafe
# Semantic retrieval: 1 = load sentence-transformers/all-MiniLM-L6-v2, 0 = keyword + graph only
SPACEXI_SEMANTIC=1
SPACEXI_EMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2
# CORS for a separately hosted frontend (comma-separated); "*" for single-service deployment
ALLOWED_ORIGINS=*
# Protects POST /api/evaluation/claude-live (runs the paid live Claude evaluation). Any long random string.
ADMIN_TOKEN=
# --- Multi-model routing (Scientific Copilot). Model IDs are verified against the API at startup. ---
SXS_MODEL_FAST=claude-haiku-5-5        # tier 1: app enquiries, terminology, summaries
SXS_MODEL_STANDARD=claude-sonnet-5-5   # tier 2: evidence-grounded science (defaults to ANTHROPIC_MODEL)
SXS_MODEL_DEEP=claude-opus-5-5         # tier 3: conflicts, synthesis, interacting conditions
SXS_MAXTOK_FAST=500
SXS_MAXTOK_STANDARD=900
SXS_MAXTOK_DEEP=1400
# Prices for cost estimates, USD per million tokens "input,output" (defaults: Anthropic pricing page, 2026-11-14)
SXS_PRICE_FAST=
SXS_PRICE_STANDARD=
SXS_PRICE_DEEP=
SXS_RATE_PER_MIN=20                    # LLM calls per client per minute
SXS_DAILY_BUDGET_USD=2.0               # estimated spend per UTC day; beyond it the copilot uses evidence mode
SXS_DAILY_TOKEN_BUDGET=400000
SXS_CACHE_TTL_S=3600
